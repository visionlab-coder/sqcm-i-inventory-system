<%- include('partials/header') %>
<div class="page-heading"><div><p class="eyebrow">GOVERNANCE</p><h1>감사 로그</h1><p class="muted">최근 200건의 인증 및 비품 변경 이력입니다.</p></div></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>시각</th><th>작업자</th><th>작업</th><th>대상</th><th>요청 추적</th><th>세부정보</th></tr></thead><tbody><% logs.forEach(log => { %><tr><td><%= new Date(log.created_at).toLocaleString('ko-KR') %></td><td><%= log.display_name || '시스템/미확인' %><br><small><%= log.email || '' %></small></td><td><span class="badge neutral"><%= log.action %></span></td><td><%= log.entity_type %> <%= log.entity_id || '' %></td><td class="mono details"><%= log.request_id || '-' %><br><%= log.ip_address || '-' %></td><td class="mono details"><%= JSON.stringify(log.metadata) %></td></tr><% }) %></tbody></table></div></section>
<%- include('partials/footer') %>
