<%- include('partials/header') %>
<div class="page-heading"><div><p class="eyebrow">INVENTORY</p><h1>비품 관리</h1><p class="muted">코드, 이름, 카테고리로 검색하고 재고를 확인합니다.</p></div></div>
<section class="panel filter-panel">
  <form class="filter-form" method="get"><label>검색<input type="search" name="q" value="<%= query %>" placeholder="코드, 비품명, 카테고리"></label><label>상태<select name="status"><option value="ALL">전체</option><option value="AVAILABLE" <%= status==='AVAILABLE'?'selected':'' %>>대여 가능</option><option value="LOW" <%= status==='LOW'?'selected':'' %>>재고 부족</option></select></label><button class="secondary" type="submit">검색</button></form>
</section>
<section class="panel"><div class="panel-head"><h2>비품 목록 <span class="count"><%= items.length %></span></h2></div><div class="table-wrap"><table><thead><tr><th>코드</th><th>비품명</th><th>카테고리</th><th>위치</th><th>가용</th><th>총수량</th><th>상태</th></tr></thead><tbody>
  <% items.forEach(item => { const low=item.available_quantity<=item.min_quantity; %><tr><td class="mono"><%= item.code %></td><td><strong><%= item.name %></strong></td><td><%= item.category %></td><td><%= item.location || '-' %></td><td><%= item.available_quantity %></td><td><%= item.total_quantity %></td><td><span class="badge <%= low?'bad':'good' %>"><%= low?'재고 부족':'정상' %></span></td></tr><% }) %>
  <% if (!items.length) { %><tr><td colspan="7" class="empty">검색 결과가 없습니다.</td></tr><% } %>
</tbody></table></div></section>
<% if (['MANAGER','ADMIN'].includes(currentUser.role)) { %><section id="new" class="panel form-panel"><div><p class="eyebrow">NEW ITEM</p><h2>비품 등록</h2><p class="muted">코드는 등록 후 식별 기준이 되므로 중복할 수 없습니다.</p></div><form class="grid-form" action="/items" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>비품 코드<input name="code" required pattern="[A-Za-z0-9-]{3,30}" placeholder="EQ-000109"></label><label>비품명<input name="name" required minlength="2" maxlength="100"></label><label>카테고리<input name="category" required maxlength="50"></label><label>위치<input name="location" maxlength="100"></label><label>총수량<input type="number" name="totalQuantity" required min="0"></label><label>최소재고<input type="number" name="minQuantity" required min="0" value="0"></label><button class="primary" type="submit">비품 등록</button></form></section><% } %>
<%- include('partials/footer') %>
