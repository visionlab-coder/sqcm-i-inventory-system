<%- include('partials/header') %>
<div class="page-heading"><div><p class="eyebrow">CHECKOUT & RETURN</p><h1>대여·반납</h1><p class="muted"><%= manager ? '비품의 대여와 반납을 처리합니다.' : '내 대여 현황을 확인합니다.' %></p></div></div>
<% if (manager) { %><section id="checkout" class="panel form-panel"><div><p class="eyebrow">NEW CHECKOUT</p><h2>대여 처리</h2><p class="muted">가용 재고 범위 안에서만 처리됩니다.</p></div><form class="grid-form" action="/loans" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>대여자<select name="borrowerEmail" required><option value="">선택</option><% users.forEach(user => { %><option value="<%= user.email %>"><%= user.display_name %> (<%= user.email %>)</option><% }) %></select></label><label>비품<select name="itemId" required><option value="">선택</option><% items.forEach(item => { %><option value="<%= item.id %>"><%= item.name %> · 가용 <%= item.available_quantity %></option><% }) %></select></label><label>수량<input type="number" name="quantity" min="1" value="1" required></label><label>반납 예정<input type="datetime-local" name="dueAt" required></label><button class="primary" type="submit">대여 확정</button></form></section><% } %>
<section class="panel"><div class="panel-head"><h2><%= manager ? '전체 대여 이력' : '내 대여 이력' %></h2></div><div class="table-wrap"><table><thead><tr><th>비품</th><th>대여자</th><th>수량</th><th>대여일</th><th>반납 예정</th><th>상태</th><% if(manager){ %><th>처리</th><% } %></tr></thead><tbody>
<% loans.forEach(loan => { %><tr><td><strong><%= loan.item_name %></strong><br><span class="mono"><%= loan.code %></span></td><td><%= loan.borrower_name %></td><td><%= loan.quantity %></td><td><%= new Date(loan.loaned_at).toLocaleDateString('ko-KR') %></td><td><%= new Date(loan.due_at).toLocaleDateString('ko-KR') %></td><td><span class="badge <%= loan.returned_at?'good':loan.overdue?'bad':'neutral' %>"><%= loan.returned_at?'반납 완료':loan.overdue?'연체':'대여 중' %></span></td><% if(manager){ %><td><% if(!loan.returned_at){ %><form class="inline-form" action="/loans/<%= loan.id %>/return" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="condition" aria-label="반납 상태"><option value="GOOD">정상</option><option value="DAMAGED">손상</option><option value="LOST">분실</option></select><button class="small" type="submit">반납</button></form><% } %></td><% } %></tr><% }) %>
<% if(!loans.length){ %><tr><td colspan="7" class="empty">대여 이력이 없습니다.</td></tr><% } %></tbody></table></div></section>
<%- include('partials/footer') %>
