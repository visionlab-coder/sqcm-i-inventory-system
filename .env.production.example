# 복사 후 실제 운영값으로 교체하십시오. 이 파일에는 비밀값을 저장하지 않습니다.
POSTGRES_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
SEED_MANAGER_PASSWORD=replace-with-another-12-random-characters
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FRONTEND_PORT=3000
RELEASE_TAG=replace-with-git-sha
DEPLOY_TARGET=production
