# 복사 후 실제 운영값으로 교체하십시오. 이 파일에는 비밀값을 저장하지 않습니다.
POSTGRES_PASSWORD=replace-with-at-least-16-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
DB_AUTO_MIGRATE=false
DB_RUN_SEEDS=false
DB_MIGRATION_HISTORY_MODE=application
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
AUTOMATION_WORKER_ENABLED=true
AUTOMATION_WORKER_INTERVAL_MS=60000
COOKIE_SECURE=true
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
FRONTEND_PORT=3000
BACKEND_IMAGE=ghcr.io/visionlab-coder/sqcm-i-inventory-backend
FRONTEND_IMAGE=ghcr.io/visionlab-coder/sqcm-i-inventory-frontend
RELEASE_TAG=sha-replace-with-40-character-git-sha
DEPLOY_TARGET=production
PUBLIC_BASE_URL=https://inventory.safe-link.co.kr
TRUSTED_PROXY_COUNT=1
AUTH_PROVIDER=local
PRODUCTION_LOCAL_AUTH_MFA_REQUIRED=true
FILE_STORAGE_DRIVER=postgres
MALWARE_SCAN_DRIVER=external
OPERATIONAL_ADAPTER_MODULE=/app/src/adapters/staging-operational-adapters.js
OIDC_REDIRECT_URI=
EVENT_PUBLISHER_URL=https://events.office.example/v1/publish
EVENT_PUBLISHER_API_KEY_FILE=/run/secrets/event-publisher-api-key
AI_PROVIDER_DRIVER=external
AI_PROVIDER_URL=https://ai-bridge.office.example/recommend
AI_PROVIDER_OCR_URL=https://ai-bridge.office.example/ocr
AI_PROVIDER_HEALTH_URL=https://ai-bridge.office.example/health
AI_PROVIDER_READY_URL=https://ai-bridge.office.example/ready
AI_PROVIDER_API_KEY_FILE=/run/secrets/ai-provider-api-key
AI_PROVIDER_MODEL=cost-control-v1
AI_PROVIDER_NAME=office-ai-bridge
AI_PROVIDER_TIMEOUT_MS=12000
MALWARE_SCANNER_URL=https://security.office.example/scan
MALWARE_SCANNER_HEALTH_URL=https://security.office.example/health
MALWARE_SCANNER_API_KEY_FILE=/run/secrets/malware-scanner-api-key
ALERTING_URL=https://security.office.example/alert
ALERTING_API_KEY_FILE=/run/secrets/alerting-api-key
