{
  "name": "seowon-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "서원토건 비품관리 교육용 웹 애플리케이션",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test test/unit/**/*.test.js",
    "test:integration": "node scripts/require-integration-env.mjs && node --test test/integration/**/*.test.js",
    "check:syntax": "node scripts/syntax-check.mjs",
    "check": "npm run check:syntax && npm run test:unit",
    "check:full": "npm run check && npm run test:integration",
    "deploy:check": "node scripts/deploy-precheck.mjs",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "maintenance:check": "node scripts/maintenance-check.mjs",
    "operations:contracts": "node scripts/operations-contract-check.mjs",
    "operations:preflight": "node scripts/operations-preflight.mjs",
    "operations:cutover-gate": "node scripts/cutover-gate.mjs",
    "operations:health": "node scripts/operational-health-check.mjs",
    "test:nonfunctional": "node scripts/nonfunctional-check.mjs",
    "test:recovery": "node scripts/dependency-recovery-check.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore-drill": "node scripts/db-restore-drill.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:verify": "node scripts/db-verify-migrations.mjs",
    "automation:worker": "node scripts/automation-worker.mjs",
    "ui:contract": "node scripts/ui-contract-check.mjs",
    "compose:contract": "node scripts/compose-contract-check.mjs",
    "repository:hygiene": "node scripts/repository-hygiene-check.mjs",
    "ci:env": "node scripts/write-ci-env.mjs",
    "ai:preflight": "node scripts/ai-bridge-preflight.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
